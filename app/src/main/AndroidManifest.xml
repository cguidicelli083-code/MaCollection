<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès réseau (catalogue de jeux en ligne + jaquettes). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Retour haptique des mini-jeux (vibration à la perte d'une vie). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Prise de photo (scan). La sélection depuis la galerie passe par le sélecteur de photos
         moderne d'Android (PickVisualMedia), qui ne nécessite aucune permission de lecture média. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MaCollectionApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaCollection">

        <!-- Pré-télécharge les modèles ML Kit (code-barres + OCR) à l'installation. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode,ocr,ocr_japanese" />

        <!-- App ID de TEST officiel Google AdMob (jamais d'ID de production inventé ici :
             voir ui/ads/AdsManager.kt pour les unités publicitaires, elles aussi en mode
             test tant qu'un vrai compte AdMob n'est pas configuré). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6018236504099673~7667978279" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Notre thème par défaut n'a pas de barre d'outils (NoActionBar) : sans cette
             redéfinition, l'écran de recadrage de la bibliothèque hérite de ce thème et le
             bouton de validation (dans la barre d'outils) ne s'affiche jamais. -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat" />

        <activity
            android:name=".Console3DActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.MaCollection" />

        <!-- Verrouillé en portrait : une rotation recréerait l'écran et perdrait tout
             formulaire en cours (les champs ne sont pas conçus pour survivre à ça). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
